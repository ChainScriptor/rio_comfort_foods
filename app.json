{
  "expo": {
    "name": "Comfort Foods",
    "slug": "mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/applogo.png",
    "scheme": "mobile",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.stathis.riocomfortfoods"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/applogo.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.stathis.riocomfortfoods"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "display": "standalone",
      "orientation": "portrait",
      "name": "Comfort Foods",
      "shortName": "Comfort Foods",
      "description": "Comfort Foods - Περιήγηση σε όλα τα προϊόντα",
      "themeColor": "#121212",
      "backgroundColor": "#121212",
      "startUrl": "/",
      "scope": "/"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#000000"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e4e0084f-8fa4-41dc-8c07-d2f056554845"
      }
    }
  }
}
