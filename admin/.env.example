# Clerk (required for Admin login). Use the same key as mobile if same Clerk app.
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxxx

# Origin where the Admin SPA is served (OAuth redirect URLs). Default: https://www.comfortfoods.store
# Αν το admin είναι σε άλλο host (π.χ. admin.comfortfoods.store), όρισέ το εδώ.
# VITE_APP_ORIGIN=https://www.comfortfoods.store

# Backend API base URL (πρέπει να τελειώνει σε /api). Αν κενό, χρησιμοποιείται relative /api (same-origin).
# VITE_API_URL=https://your-api.example.com/api

# Optional: Sentry DSN for error tracking
# VITE_SENTRY_DSN=
